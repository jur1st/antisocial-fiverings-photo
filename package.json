{
  "name": "antisocial-fiverings-photo",
  "version": "1.0.0",
  "description": "Antisocial photography platform with automated testing",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:gallery": "playwright test tests/gallery.spec.ts",
    "test:navigation": "playwright test tests/navigation.spec.ts",
    "test:images": "playwright test tests/images.spec.ts",
    "test:report": "playwright show-report",
    "validate": "npm run test && hugo --renderToMemory",
    "build": "hugo --minify",
    "serve": "hugo server -D",
    "clean": "rm -rf public resources",
    "precommit": "npm run validate",
    "css:dev": "postcss static/css/src/main.css -o static/css/dist/gallery.css --env development --watch",
    "css:build": "postcss static/css/src/main.css -o static/css/dist/gallery.min.css --env production",
    "css:analyze": "postcss static/css/src/main.css -o static/css/dist/gallery.css --env development --verbose",
    "server:prod": "hugo server --port 1313",
    "server:test": "CSS_MODE=optimized hugo server --port 3000",
    "server:compare": "npm-run-all --parallel server:prod server:test"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "autoprefixer": "^10.4.16",
    "cssnano": "^6.0.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.32",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^15.1.0",
    "postcss-reporter": "^7.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}